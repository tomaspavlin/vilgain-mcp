{
  "name": "vilgain-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for shopping on Vilgain.cz (healthy food e-shop, formerly Aktin)",
  "keywords": [
    "mcp",
    "vilgain",
    "aktin",
    "grocery",
    "shopping",
    "nutrition"
  ],
  "author": "Tomas Pavlin",
  "license": "MIT",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomaspavlin/vilgain-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tomaspavlin/vilgain-mcp/issues"
  },
  "homepage": "https://github.com/tomaspavlin/vilgain-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node --env-file=.env dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate-api": "npm run build && node --env-file=.env dist/validate-api.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "cheerio": "^1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
